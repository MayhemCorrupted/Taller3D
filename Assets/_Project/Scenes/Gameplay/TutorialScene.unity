--- !u!114 &928608368
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 928608366}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f1f5ccf535811b34c97991385311eb16, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueLibrary
  dialogueEntries:
  - dialogueKey: TutorialText
    dialogueLines:
    - "\xBFDonde estoy?"
    - ... Mejor busco a mis padres.
    uiTextComponent: {fileID: 640296960}
    targetToLookAt: {fileID: 640296959}
  - dialogueKey: FuseNotItem
    dialogueLines:
    - Falta un fusible en la caja... deberia buscarlo.
    uiTextComponent: {fileID: 406381012}
    targetToLookAt: {fileID: 406381011}
  - dialogueKey: DoorJacksonLocked
    dialogueLines:
    - "\xBFPor que esta cerrada?"
    - No recuerdo cerrarla... necesito encontrar a mis padres
    uiTextComponent: {fileID: 2137810018}
    targetToLookAt: {fileID: 2137810017}
  - dialogueKey: TakeFuse
    dialogueLines:
    - "Recuerdo que pap\xE1 bajaba de vez en cuando con uno de estos al sotano."
    uiTextComponent: {fileID: 673232819}
    targetToLookAt: {fileID: 673232818}
  - dialogueKey: TutorialDoorText
    dialogueLines:
    - Esta cerrada... necesito encontrar algo que me ayude a salir.
    uiTextComponent: {fileID: 1995883795}
    targetToLookAt: {fileID: 1995883794}
  - dialogueKey: LivingRoomIndication
    dialogueLines:
    - Necesito encontrar a mis padres, deberia subir a su habitacion.
    uiTextComponent: {fileID: 676494772}
    targetToLookAt: {fileID: 676494771}
  - dialogueKey: DoorOfficeClosed
    dialogueLines:
    - '!AH!'
    - "\xBFQue paso?"
    uiTextComponent: {fileID: 1275667710}
    targetToLookAt: {fileID: 1275667709}
  - dialogueKey: ParentsRoomDialogue
    dialogueLines:
    - "Espero que mis padres si est\xE9n aqu\xED...."
    uiTextComponent: {fileID: 867629240}
    targetToLookAt: {fileID: 867629239}

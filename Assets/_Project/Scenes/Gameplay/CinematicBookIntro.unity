  steps:
  - panelImage: {fileID: 378476446}
    textUI: {fileID: 1466280473}
    dialogueText: 
    audioSource: {fileID: 1639179776}
    audioClip: {fileID: 0}
  - panelImage: {fileID: 0}
    textUI: {fileID: 1466280473}
    dialogueText: "Al poco tiempo, los dem\xE1s empezaron a preocuparse."
    audioSource: {fileID: 1639179776}
    audioClip: {fileID: 0}
  - panelImage: {fileID: 0}
    textUI: {fileID: 1466280473}
    dialogueText: "\"\xBFLe ocurre algo?\"."
    audioSource: {fileID: 1639179776}
    audioClip: {fileID: 0}
  - panelImage: {fileID: 334067561}
    textUI: {fileID: 1466280473}
    dialogueText: 
    audioSource: {fileID: 1639179776}
    audioClip: {fileID: 0}
  - panelImage: {fileID: 0}
    textUI: {fileID: 1466280473}
    dialogueText: "\"El... solo est\xE1 cansado, ma\xF1ana estar\xE1 mejor.\""
    audioSource: {fileID: 1639179776}
    audioClip: {fileID: 0}

  m_Script: {fileID: 11500000, guid: 714414b898dbf1a4e83ea16fa025e033, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ComicPanel
  virtualCamera: {fileID: 1792365071}
  fadeSpeed: 2
  textSpeed: 0.03
  globalFont: {fileID: 11400000, guid: 0b9caa11d596f9440a9a200e8cd8de26, type: 2}
  globalColor: {r: 0.1792453, g: 0.1792453, b: 0.1792453, a: 1}

  steps:
  - panelImage: {fileID: 549380639}
    textUI: {fileID: 447870000}
    dialogueText: 
    audioSource: {fileID: 1639179776}
    audioClip: {fileID: 0}
  - panelImage: {fileID: 0}
    textUI: {fileID: 447870000}
    dialogueText: "Se dio cuenta de que... no pod\xEDa recordar el rostro de nadie."
    audioSource: {fileID: 1639179776}
    audioClip: {fileID: 0}
  - panelImage: {fileID: 271008650}
    textUI: {fileID: 447870000}
    dialogueText: 
    audioSource: {fileID: 1639179776}
    audioClip: {fileID: 0}
  - panelImage: {fileID: 0}
    textUI: {fileID: 447870000}
    dialogueText: Tuvo miedo.
    audioSource: {fileID: 1639179776}
    audioClip: {fileID: 0}
  - panelImage: {fileID: 0}
    textUI: {fileID: 447870000}
    dialogueText: "Si olvidaba a todos... podr\xEDan desaparecer."
    audioSource: {fileID: 1639179776}
    audioClip: {fileID: 0}

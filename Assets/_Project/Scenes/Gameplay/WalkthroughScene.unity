  m_Script: {fileID: 11500000, guid: f1f5ccf535811b34c97991385311eb16, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueLibrary
  dialogueEntries:
  - dialogueKey: TutorialText
    dialogueLines:
    - "\xBFDonde estoy?"
    - ... Mejor busco a mis padres.
    uiTextComponent: {fileID: 640296960}
    targetToLookAt: {fileID: 640296959}
  - dialogueKey: FuseNotItem
    dialogueLines:
    - Falta un fusible en la caja... deberia buscarlo.
    uiTextComponent: {fileID: 406381012}
    targetToLookAt: {fileID: 406381011}
  - dialogueKey: DoorJacksonLocked
    dialogueLines:
    - "\xBFPor que esta cerrada?"
    - No recuerdo cerrarla... necesito encontrar a mis padres
    uiTextComponent: {fileID: 2137810018}
    targetToLookAt: {fileID: 2137810017}
  - dialogueKey: TakeFuse
    dialogueLines:
    - "Recuerdo que pap\xE1 bajaba de vez en cuando con uno de estos al sotano."
    uiTextComponent: {fileID: 673232819}
    targetToLookAt: {fileID: 673232818}
  - dialogueKey: TutorialDoorText
    dialogueLines:
    - Esta cerrada... necesito encontrar algo que me ayude a salir.
    uiTextComponent: {fileID: 1995883795}
    targetToLookAt: {fileID: 1995883794}
  - dialogueKey: LivingRoomIndication
    dialogueLines:
    - Necesito encontrar a mis padres, deberia subir a su habitacion.
    uiTextComponent: {fileID: 676494772}
    targetToLookAt: {fileID: 676494771}
  - dialogueKey: DoorOfficeClosed
    dialogueLines:
    - '!AH!'
    - Segun esto deberia haber una entrada por algun lado, deberia revisarlo mejor.
    uiTextComponent: {fileID: 1275667710}
    targetToLookAt: {fileID: 1275667709}
  - dialogueKey: ParentsRoomDialogue
    dialogueLines:
    - "Espero que mis padres si est\xE9n aqu\xED...."
    uiTextComponent: {fileID: 867629240}
    targetToLookAt: {fileID: 867629239}
  - dialogueKey: FirstSecretWall
    dialogueLines:
    - "\xBFQue es esto?\n\xBFDonde estoy?"
    uiTextComponent: {fileID: 700980047}
    targetToLookAt: {fileID: 700980046}
  - dialogueKey: SecondSecretWall
    dialogueLines:
    - "\xBFAlguien me escucha?"
    uiTextComponent: {fileID: 607824711}
    targetToLookAt: {fileID: 607824710}
  - dialogueKey: ThirdSecretWall
    dialogueLines:
    - "\xA1Mam\xE1!"
    uiTextComponent: {fileID: 606397957}
    targetToLookAt: {fileID: 606397956}
  - dialogueKey: FiveSecretWall
    dialogueLines:
    - "\xBFMam\xE1...?"
    uiTextComponent: {fileID: 596445520}
    targetToLookAt: {fileID: 596445519}
  - dialogueKey: FourSecretWall
    dialogueLines:
    - "\xA1Pap\xE1!"
    uiTextComponent: {fileID: 277407453}
    targetToLookAt: {fileID: 277407452}
  - dialogueKey: SixSecretWall
    dialogueLines:
    - "\xBFEs eso una puerta?"
    uiTextComponent: {fileID: 1839111254}
    targetToLookAt: {fileID: 1839111253}
  - dialogueKey: JacksonRoom
    dialogueLines:
    - 'Quueee... '
    uiTextComponent: {fileID: 801967911}
    targetToLookAt: {fileID: 801967910}
  - dialogueKey: DemoText
    dialogueLines:
    - Fin de la demo
    - "Gracias por jugar, le agradeceria que haga la siguiente encuesta a continuaci\xF3n "
    uiTextComponent: {fileID: 1659991843}
    targetToLookAt: {fileID: 1659991841}
  - dialogueKey: LibraryText
    dialogueLines:
    - Esta cerrado, que raro....
    - La caja de luz esta abajo, quizas sirva de algo...
    uiTextComponent: {fileID: 229083072}
    targetToLookAt: {fileID: 229083071}

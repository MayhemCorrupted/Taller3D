      textMeshComponent: {fileID: 229083072}
      lineTypingDuration: 0.5
      timePerCharacter: 0
      fadeDuration: 0
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
    - textLine: I remember Dad saying that this door did not have a passcode
      dialogueType: 1
      targetToLookAt: {fileID: 229083071}
      textMeshComponent: {fileID: 0}
      lineTypingDuration: 0
      timePerCharacter: 0
      fadeDuration: 0
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
    - textLine: it just needed to be plugged in..
      dialogueType: 1
      targetToLookAt: {fileID: 229083071}
      textMeshComponent: {fileID: 0}
      lineTypingDuration: 0
      timePerCharacter: 0
      fadeDuration: 0
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
    - textLine: 'The fuse box is in the basement. '
      dialogueType: 1
      targetToLookAt: {fileID: 229083071}
      textMeshComponent: {fileID: 0}
      lineTypingDuration: 0
      timePerCharacter: 0
      fadeDuration: 0
      onLineStart:
        m_PersistentCalls:
          m_Calls:
          - m_Target: {fileID: 1550039657}
            m_TargetAssemblyTypeName: StateProgressionManager, Assembly-CSharp
            m_MethodName: OverrideHintText
            m_Mode: 5
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 0
              m_FloatArgument: 0
              m_StringArgument: Go to the basement
              m_BoolArgument: 0
            m_CallState: 2
    - textLine: Maybe that will help...
      dialogueType: 1
      targetToLookAt: {fileID: 229083071}
      textMeshComponent: {fileID: 0}
      lineTypingDuration: 0
      timePerCharacter: 0
      fadeDuration: 0
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
  - dialogueKey: FuseNotItem
    dialogueSequence:
    - textLine: I need the fuse...
      dialogueType: 1
      targetToLookAt: {fileID: 406381011}
      textMeshComponent: {fileID: 406381012}
      lineTypingDuration: 1
      timePerCharacter: 0
      fadeDuration: 0
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
    - textLine: I will look for it in the garage
      dialogueType: 1
      targetToLookAt: {fileID: 406381011}
      textMeshComponent: {fileID: 0}
      lineTypingDuration: 0
      timePerCharacter: 0
      fadeDuration: 0
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
  - dialogueKey: TakeFuse
    dialogueSequence:
    - textLine: I remember Dad sometimes went down to the basement with one of these.
      dialogueType: 1
      targetToLookAt: {fileID: 673232818}
      textMeshComponent: {fileID: 673232819}
      lineTypingDuration: 1
      timePerCharacter: 0
      fadeDuration: 0
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
  - dialogueKey: DoorJacksonLocked
    dialogueSequence:
    - textLine: Why It is locked?
      dialogueType: 1
      targetToLookAt: {fileID: 2137810017}
      textMeshComponent: {fileID: 2137810018}
      lineTypingDuration: 1
      timePerCharacter: 0
      fadeDuration: 0
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
    - textLine: I do not remember leaving my room...
      dialogueType: 1
      targetToLookAt: {fileID: 2137810017}
      textMeshComponent: {fileID: 0}
      lineTypingDuration: 0
      timePerCharacter: 0
      fadeDuration: 0
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
  - dialogueKey: DoorOfficeClosed
    dialogueSequence:
    - textLine: AH!
      dialogueType: 1
      targetToLookAt: {fileID: 1275667709}
      textMeshComponent: {fileID: 1275667710}
      lineTypingDuration: 1
      timePerCharacter: 0
      fadeDuration: 0
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
    - textLine: What was that... Mom?
      dialogueType: 1
      targetToLookAt: {fileID: 2137810017}
      textMeshComponent: {fileID: 0}
      lineTypingDuration: 0
      timePerCharacter: 0
      fadeDuration: 0
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
    - textLine: I should better take a look at the blueprint I picked up
      dialogueType: 1
      targetToLookAt: {fileID: 1275667709}
      textMeshComponent: {fileID: 0}
      lineTypingDuration: 0
      timePerCharacter: 0
      fadeDuration: 0
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
  - dialogueKey: FirstSecretWall
    dialogueSequence:
    - textLine: What... what it is?
      dialogueType: 1
      targetToLookAt: {fileID: 700980046}
      textMeshComponent: {fileID: 700980047}
      lineTypingDuration: 1
      timePerCharacter: 0
      fadeDuration: 0
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
    - textLine: Where I am?
      dialogueType: 1
      targetToLookAt: {fileID: 229083071}
      textMeshComponent: {fileID: 0}
      lineTypingDuration: 0
      timePerCharacter: 0
      fadeDuration: 0
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
  - dialogueKey: SecondSecretWall
    dialogueSequence:
    - textLine: Someone can hear me?
      dialogueType: 1
      targetToLookAt: {fileID: 607824710}

  dialogueEntries:
  - dialogueKey: InitialText
    dialogueSequence:
    - textLine: Where I am?
      dialogueType: 1
      targetToLookAt: {fileID: 640296959}
      textMeshComponent: {fileID: 640296960}
      lineTypingDuration: 1
      timePerCharacter: 0
      fadeDuration: 0
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
    - textLine: I have to find my parents...
      dialogueType: 1
      targetToLookAt: {fileID: 0}
      textMeshComponent: {fileID: 0}
      lineTypingDuration: 0
      timePerCharacter: 0
      fadeDuration: 0
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
  - dialogueKey: TutorialDoorText
    dialogueSequence:
    - textLine: 'The door is closed... '
      dialogueType: 1
      targetToLookAt: {fileID: 1995883794}
      textMeshComponent: {fileID: 1995883795}
      lineTypingDuration: 1
      timePerCharacter: 0
      fadeDuration: 0
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
    - textLine: I need the key. Where could the key be?
      dialogueType: 1
      targetToLookAt: {fileID: 0}
      textMeshComponent: {fileID: 0}
      lineTypingDuration: 0
      timePerCharacter: 0
      fadeDuration: 0
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
  - dialogueKey: LivingRoomIndication
    dialogueSequence:
    - textLine: 'I have to find my mother '
      dialogueType: 1
      targetToLookAt: {fileID: 676494771}
      textMeshComponent: {fileID: 676494772}
      lineTypingDuration: 1
      timePerCharacter: 0
      fadeDuration: 0
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
    - textLine: She might be in her room.
      dialogueType: 1
      targetToLookAt: {fileID: 676494771}
      textMeshComponent: {fileID: 0}
      lineTypingDuration: 0
      timePerCharacter: 0
      fadeDuration: 0
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
  - dialogueKey: ParentsRoomDialogue
    dialogueSequence:
    - textLine: I hope my parents are in in the room
      dialogueType: 1
      targetToLookAt: {fileID: 867629239}
      textMeshComponent: {fileID: 867629240}
      lineTypingDuration: 0
      timePerCharacter: 0
      fadeDuration: 0
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
  - dialogueKey: LibraryText
